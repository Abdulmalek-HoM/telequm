   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Implementation: Simulating Physics with Qiskit Dynamics",
    "We can use `Qiskit Dynamics` to simulate the Schrödinger equation and visualize how a microwave pulse drives a qubit, moving beyond the abstract circuit model to the physical control layer."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from qiskit_dynamics import Solver, RotatingFrame, Signal, QubitSystem\n",
    "from qiskit.quantum_info import Operator\n",
    "\n",
    "# 1. Define the System (Transmon Qubit)\n",
    "# Frequencies are in rad/s, time in ns\n",
    "qubit_freq = 5.0 * 2 * np.pi  # 5 GHz\n",
    "\n",
    "# 2. Define the Drive Hamiltonian (rotating frame at qubit_freq)\n",
    "X = Operator.from_label('X').data\n",
    "Y = Operator.from_label('Y').data\n",
    "drive_op = X / 2 + 1j * Y / 2  # The drive component (sigma+)\n",
    "\n",
    "# System definition (no decoherence for simplicity)\n",
    "qubit_system = QubitSystem(qubit_freq=qubit_freq)\n",
    "solver = Solver(static_hamiltonian=qubit_system.static_hamiltonian,\n",
    "                hamiltonian_operators=[X],\n",
    "                rotating_frame=RotatingFrame(qubit_system.static_hamiltonian))\n",
    "\n",
    "# 3. Define the Pulse (Simple rectangular pulse for demonstration)\n",
    "drive_amplitude = 0.5 * np.pi  # Rabi frequency (amplitude)\n",
    "gate_duration = 1.0          # Time to complete a pi-rotation, e.g., 1 ns\n",
    "times = np.linspace(0, gate_duration, 101)\n",
    "\n",
    "def square_pulse(t, amp, duration):\n",
    "    return amp * (t >= 0) * (t <= duration)\n",
    "\n",
    "drive_signal = Signal(square_pulse, drive_amplitude, gate_duration)\n",
    "\n",
    "# 4. Solve the Dynamics (Schrödinger equation)\n",
    "initial_state = np.array([1.0, 0.0])  # Start in |0>\n",
    "result = solver.solve(t_span=times, initial_state=initial_state, signals=[drive_signal])\n",
    "\n",
    "# 5. Visualize the Population Dynamics\n",
    "populations = np.abs(result.y)**2\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(times, populations[:, 0], label='|0> Population')\n",
    "plt.plot(times, populations[:, 1], label='|1> Population')\n",
    "plt.xlabel('Time (ns)')\n",
    "plt.ylabel('Population Probability')\n",
    "plt.title('Rabi Oscillation Simulation (Ideal X-Gate)')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
  }
