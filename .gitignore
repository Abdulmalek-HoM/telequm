# TELEQUM .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
.venvQuantumHeist/
ENV/
env/
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Large data files
*.json
!dashboard/data/*.json
*.csv
*.h5
*.hdf5
*.pkl
*.pickle

# Logs
*.log
logs/

# Local configuration
.env.local
*.local

# Temporary files
tmp/
temp/
*.tmp

# Qiskit cache
.qiskit/
